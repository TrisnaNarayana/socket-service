FROM node:20-alpine AS builder

# Install OpenSSL for Prisma engine compatibility on Alpine Linux
RUN apk add --no-cache openssl

WORKDIR /app

# Copy root configuration and package files
COPY package*.json ./
COPY tsconfig.base.json ./

# Copy packages
COPY packages/database ./packages/database
COPY packages/shared ./packages/shared

# Copy backend app
COPY apps/backend ./apps/backend

# Install dependencies, generate Prisma types, and build
RUN npm install
RUN npm run db:generate --workspace=@vms/database
RUN npm run build --workspace=@vms/database
RUN npm run build --workspace=@vms/shared
RUN npm run build --workspace=@vms/backend

EXPOSE 4000

ENV NODE_ENV=production

CMD ["node", "apps/backend/dist/server.js"]
